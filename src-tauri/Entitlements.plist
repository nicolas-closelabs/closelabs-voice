<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- CloseLabs Voice: permite cargar el ONNX Runtime (libonnxruntime.dylib,
         de terceros/sin nuestra firma) aun con hardened runtime. Sin esto, la
         build de Intel se cae al abrir con "Library not loaded" porque macOS
         (Library Validation) rechaza el dylib externo. Válido también con
         notarización (Fase 2). El build ARM no lo necesita (ONNX estático). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>