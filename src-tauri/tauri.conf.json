{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloseLabs Voice",
  "version": "0.9.0",
  "identifier": "com.closelabs.voice",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {},
      "hardenedRuntime": false,
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ],
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      },
      "rpm": {
        "compression": {
          "type": "none"
        },
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib": "transcribe-libs"
        }
      }
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QUY2OEJBNTMzNzczQjgKUldTNGN6ZFR1bWl2cUFBcFB5TVMvUFpTV3NCSUNpbUlSUHE4dDVxRStudWphaldtNE0wWmwzeXQK",
      "endpoints": [
        "https://gdizmbuzepxnkiahbeoz.supabase.co/functions/v1/update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
